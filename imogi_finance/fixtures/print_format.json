  "html": "<style>\r\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\r\n\r\n  .towing-invoice * {\r\n    box-sizing: border-box;\r\n    margin: 0;\r\n    padding: 0;\r\n  }\r\n\r\n  .towing-invoice {\r\n    font-family: 'Plus Jakarta Sans', Arial, sans-serif;\r\n    font-size: 11px;\r\n    color: #1a1a2e;\r\n    background: #fff;\r\n    width: 100%;\r\n    max-width: 800px;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  /* ── PAGE BREAK ── */\r\n  .page-break {\r\n    page-break-after: always;\r\n    margin-bottom: 30px;\r\n  }\r\n\r\n  @media print {\r\n    .page-break {\r\n      margin-bottom: 0;\r\n    }\r\n  }\r\n\r\n  /* ── HEADER ── */\r\n  .inv-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: flex-start;\r\n    background: #0f2557;\r\n    color: #fff;\r\n    padding: 24px 28px 20px;\r\n    border-radius: 4px 4px 0 0;\r\n    -webkit-print-color-adjust: exact;\r\n    print-color-adjust: exact;\r\n  }\r\n\r\n  .inv-header-left .company-name {\r\n    font-size: 20px;\r\n    font-weight: 800;\r\n    letter-spacing: -0.5px;\r\n    line-height: 1;\r\n  }\r\n\r\n  .inv-header-left .company-sub {\r\n    font-size: 9px;\r\n    font-weight: 500;\r\n    letter-spacing: 2px;\r\n    text-transform: uppercase;\r\n    opacity: 0.7;\r\n    margin-top: 3px;\r\n  }\r\n\r\n  .inv-header-left .company-address {\r\n    font-size: 9px;\r\n    opacity: 0.65;\r\n    margin-top: 10px;\r\n    line-height: 1.6;\r\n  }\r\n\r\n  .inv-header-right {\r\n    text-align: right;\r\n  }\r\n\r\n  .inv-header-right .inv-label {\r\n    font-size: 22px;\r\n    font-weight: 800;\r\n    letter-spacing: 3px;\r\n    text-transform: uppercase;\r\n    color: #f0b429;\r\n  }\r\n\r\n  .inv-header-right .inv-number {\r\n    font-size: 11px;\r\n    opacity: 0.8;\r\n    margin-top: 4px;\r\n  }\r\n\r\n  .inv-header-right .inv-dates {\r\n    margin-top: 8px;\r\n    font-size: 9.5px;\r\n    opacity: 0.7;\r\n    line-height: 1.7;\r\n  }\r\n\r\n  /* ── META ROW ── */\r\n  .inv-meta {\r\n    display: flex;\r\n    background: #f7f9fc;\r\n    border: 1px solid #e2e8f0;\r\n    border-top: none;\r\n  }\r\n\r\n  .inv-meta-block {\r\n    flex: 1;\r\n    padding: 14px 20px;\r\n    border-right: 1px solid #e2e8f0;\r\n  }\r\n\r\n  .inv-meta-block:last-child {\r\n    border-right: none;\r\n  }\r\n\r\n  .inv-meta-block .meta-label {\r\n    font-size: 8px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1.5px;\r\n    color: #64748b;\r\n    margin-bottom: 4px;\r\n  }\r\n\r\n  .inv-meta-block .meta-value {\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    color: #0f2557;\r\n  }\r\n\r\n  /* ── BILLING ── */\r\n  .inv-billing {\r\n    display: flex;\r\n    padding: 18px 20px;\r\n    border: 1px solid #e2e8f0;\r\n    border-top: none;\r\n  }\r\n\r\n  .inv-billing-to { flex: 1; }\r\n\r\n  .inv-billing-from {\r\n    flex: 1;\r\n    text-align: right;\r\n  }\r\n\r\n  .billing-label {\r\n    font-size: 8px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1.5px;\r\n    color: #64748b;\r\n    margin-bottom: 5px;\r\n  }\r\n\r\n  .billing-name {\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    color: #0f2557;\r\n  }\r\n\r\n  .billing-detail {\r\n    font-size: 9.5px;\r\n    color: #475569;\r\n    line-height: 1.7;\r\n    margin-top: 3px;\r\n  }\r\n\r\n  /* ── ITEMS TABLE (PRINT SAFE VERSION - DARK TEXT ON LIGHT BG) ── */\r\n  .inv-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border: 1px solid #e2e8f0;\r\n    border-top: none;\r\n  }\r\n\r\n  /* PRINT-SAFE: Dark background with white text changed to light background with dark text */\r\n  .inv-table thead tr {\r\n    background: #e0e7ff;\r\n    background-color: #e0e7ff !important;\r\n    border-bottom: 3px solid #0f2557;\r\n  }\r\n\r\n  .inv-table thead th {\r\n    padding: 10px 14px;\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n    text-align: left;\r\n    color: #0f2557 !important;\r\n    background-color: #e0e7ff !important;\r\n  }\r\n\r\n  .inv-table thead th.right { text-align: right; }\r\n\r\n  .inv-table tbody tr {\r\n    border-bottom: 1px solid #e2e8f0;\r\n  }\r\n\r\n  .inv-table tbody tr:nth-child(even) {\r\n    background: #f8fafc;\r\n  }\r\n\r\n  .inv-table tbody td {\r\n    padding: 12px 14px;\r\n    vertical-align: top;\r\n    font-size: 10.5px;\r\n  }\r\n\r\n  .inv-table tbody td.right {\r\n    text-align: right;\r\n    font-weight: 600;\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .item-main {\r\n    font-weight: 700;\r\n    color: #0f2557;\r\n    font-size: 11px;\r\n  }\r\n\r\n  .item-sub {\r\n    font-size: 9.5px;\r\n    color: #475569;\r\n    margin-top: 2px;\r\n  }\r\n\r\n  /* ── TOTALS TABLE (full width) ── */\r\n  .inv-totals-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border: 1px solid #e2e8f0;\r\n    border-top: none;\r\n  }\r\n\r\n  .inv-totals-table td {\r\n    padding: 8px 16px;\r\n    font-size: 10.5px;\r\n  }\r\n\r\n  .inv-totals-table .subtotal-row td {\r\n    color: #64748b;\r\n    background: #f8fafc;\r\n  }\r\n\r\n  .inv-totals-table .subtotal-row td.value {\r\n    text-align: right;\r\n    font-weight: 600;\r\n    color: #1a1a2e;\r\n  }\r\n\r\n  .inv-totals-table .tax-row td {\r\n    color: #64748b;\r\n    border-top: 1px dashed #e2e8f0;\r\n  }\r\n\r\n  .inv-totals-table .tax-row td.value {\r\n    text-align: right;\r\n    font-weight: 600;\r\n    color: #1a1a2e;\r\n  }\r\n\r\n  .inv-totals-table .total-row {\r\n    background: #0f2557;\r\n    -webkit-print-color-adjust: exact;\r\n    print-color-adjust: exact;\r\n    color-adjust: exact;\r\n  }\r\n\r\n  .inv-totals-table .total-row td {\r\n    padding: 12px 16px;\r\n    font-size: 13px;\r\n    font-weight: 800;\r\n    color: #fff !important;\r\n    border-top: none;\r\n    -webkit-print-color-adjust: exact;\r\n    print-color-adjust: exact;\r\n    color-adjust: exact;\r\n  }\r\n\r\n  .inv-totals-table .total-row td.value {\r\n    text-align: right;\r\n    color: #f0b429 !important;\r\n    font-size: 15px;\r\n  }\r\n\r\n  .inv-totals-table .spacer {\r\n    width: 60%;\r\n  }\r\n\r\n  /* ── TERBILANG ── */\r\n  .inv-terbilang {\r\n    width: 100%;\r\n    border: 1px solid #e2e8f0;\r\n    border-top: none;\r\n    padding: 10px 16px;\r\n    background: #fffbeb;\r\n    font-size: 9.5px;\r\n    color: #92400e;\r\n    font-style: italic;\r\n    display: block;\r\n  }\r\n\r\n  .inv-terbilang strong {\r\n    font-style: normal;\r\n    font-weight: 700;\r\n  }\r\n\r\n  /* ── FOOTER ── */\r\n  .inv-footer {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: flex-end;\r\n    border: 1px solid #e2e8f0;\r\n    border-top: none;\r\n    padding: 16px 20px;\r\n    background: #f7f9fc;\r\n  }\r\n\r\n  .inv-payment-info .pay-label {\r\n    font-size: 8px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1.5px;\r\n    color: #64748b;\r\n    margin-bottom: 5px;\r\n  }\r\n\r\n  .inv-payment-info .pay-detail {\r\n    font-size: 9.5px;\r\n    color: #334155;\r\n    line-height: 1.7;\r\n  }\r\n\r\n  .inv-signature {\r\n    text-align: center;\r\n    min-width: 150px;\r\n  }\r\n\r\n  .inv-signature .sig-line {\r\n    border-top: 1px solid #94a3b8;\r\n    padding-top: 6px;\r\n    font-size: 9px;\r\n    color: #64748b;\r\n  }\r\n\r\n  .inv-signature .sig-name {\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    color: #0f2557;\r\n    margin-top: 2px;\r\n  }\r\n\r\n  /* ── BOTTOM BAR ── */\r\n  .inv-bottom-bar {\r\n    background: #0f2557;\r\n    color: rgba(255,255,255,0.6);\r\n    font-size: 8.5px;\r\n    padding: 8px 20px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    border-radius: 0 0 4px 4px;\r\n    -webkit-print-color-adjust: exact;\r\n    print-color-adjust: exact;\r\n    color-adjust: exact;\r\n  }\r\n  \r\n  /* PRINT OVERRIDES */\r\n  @media print {\r\n    * {\r\n      -webkit-print-color-adjust: exact !important;\r\n      print-color-adjust: exact !important;\r\n      color-adjust: exact !important;\r\n    }\r\n    \r\n    .inv-header {\r\n      background: #0f2557 !important;\r\n    }\r\n    \r\n    .inv-table thead th {\r\n      color: #0f2557 !important;\r\n      background: #e0e7ff !important;\r\n    }\r\n    \r\n    .inv-totals-table .total-row {\r\n      background: #0f2557 !important;\r\n    }\r\n    \r\n    .inv-totals-table .total-row td {\r\n      color: #ffffff !important;\r\n    }\r\n    \r\n    .inv-totals-table .total-row td.value {\r\n      color: #f0b429 !important;\r\n    }\r\n    \r\n    .inv-bottom-bar {\r\n      background: #0f2557 !important;\r\n      color: rgba(255,255,255,0.6) !important;\r\n    }\r\n  }\r\n</style>\r\n\r\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n{% set company_address = frappe.get_all(\"Address\", filters={\"name\": doc.company_address}, fields=[\"address_line1\", \"address_line2\", \"city\", \"pincode\"], limit=1) %}\r\n\r\n{# ── PAGINATION LOGIC ── #}\r\n{% set items_per_page = 5 %}\r\n{% set total_items = doc.items | length %}\r\n{% set total_pages = ((total_items - 1) // items_per_page) + 1 if total_items > 0 else 1 %}\r\n\r\n{# ── LOOP THROUGH PAGES ── #}\r\n{% for page_num in range(1, total_pages + 1) %}\r\n  {% set start_idx = (page_num - 1) * items_per_page %}\r\n  {% set end_idx = start_idx + items_per_page %}\r\n  {% set page_items = doc.items[start_idx:end_idx] %}\r\n  {% set page_subtotal = page_items | sum(attribute='amount') %}\r\n\r\n  <div class=\"towing-invoice{% if page_num < total_pages %} page-break{% endif %}\">\r\n\r\n    <!-- HEADER (repeated on each page) -->\r\n    <div class=\"inv-header\">\r\n      <div class=\"inv-header-left\">\r\n        <div class=\"company-name\">{{ company.company_name }}</div>\r\n        <div class=\"company-sub\">PT. {{ company.company_name }}</div>\r\n        <div class=\"company-address\">\r\n          {% if company_address %}\r\n            {{ company_address[0].address_line1 or \"\" }}{% if company_address[0].address_line2 %}, {{ company_address[0].address_line2 }}{% endif %}{% if company_address[0].city %}, {{ company_address[0].city }}{% endif %}{% if company_address[0].pincode %} {{ company_address[0].pincode }}{% endif %}<br>\r\n          {% endif %}\r\n          {% if company.phone_no %}{{ company.phone_no }}{% endif %}{% if company.email %} &nbsp;|&nbsp; {{ company.email }}{% endif %}\r\n        </div>\r\n      </div>\r\n      <div class=\"inv-header-right\">\r\n        <div class=\"inv-label\">Invoice</div>\r\n        <div class=\"inv-number\">{{ doc.name }}</div>\r\n        <div class=\"inv-dates\">\r\n          Tanggal: {{ frappe.format(doc.posting_date, {\"fieldtype\": \"Date\"}) }}<br>\r\n          Jatuh Tempo: {{ frappe.format(doc.due_date, {\"fieldtype\": \"Date\"}) }}\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- META (only on first page) -->\r\n    {% if page_num == 1 %}\r\n    <div class=\"inv-meta\">\r\n      <div class=\"inv-meta-block\">\r\n        <div class=\"meta-label\">Sales Order</div>\r\n        <div class=\"meta-value\">{{ doc.items[0].sales_order if doc.items and doc.items[0].sales_order else \"-\" }}</div>\r\n      </div>\r\n      <div class=\"inv-meta-block\">\r\n        <div class=\"meta-label\">Periode</div>\r\n        <div class=\"meta-value\">{{ frappe.format(doc.posting_date, {\"fieldtype\": \"Date\"}) }}</div>\r\n      </div>\r\n      <div class=\"inv-meta-block\">\r\n        <div class=\"meta-label\">Jumlah Kendaraan</div>\r\n        <div class=\"meta-value\">{{ doc.items | length }} unit</div>\r\n      </div>\r\n      <div class=\"inv-meta-block\">\r\n        <div class=\"meta-label\">Status</div>\r\n        <div class=\"meta-value\">{{ doc.status }}</div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- BILLING (only on first page) -->\r\n    <div class=\"inv-billing\">\r\n      <div class=\"inv-billing-to\">\r\n        <div class=\"billing-label\">Ditagihkan Kepada</div>\r\n        <div class=\"billing-name\">{{ doc.customer_name or doc.customer }}</div>\r\n        <div class=\"billing-detail\">\r\n          {% if doc.address_display %}{{ doc.address_display | replace(\"\\n\", \"<br>\") }}{% endif %}\r\n        </div>\r\n      </div>\r\n      <div class=\"inv-billing-from\">\r\n        <div class=\"billing-label\">Dari</div>\r\n        <div class=\"billing-name\">{{ company.company_name }}</div>\r\n        <div class=\"billing-detail\">\r\n          {% if company.tax_id %}NPWP: {{ company.tax_id }}<br>{% endif %}\r\n          {% if company.default_bank_account %}Bank: {{ company.default_bank_account }}<br>{% endif %}\r\n          A/N: {{ company.company_name }}\r\n        </div>\r\n      </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ITEMS TABLE (current page items) -->\r\n    <table class=\"inv-table\">\r\n      <thead>\r\n        <tr>\r\n          <th style=\"width:30px\">No</th>\r\n          <th>Deskripsi Jasa</th>\r\n          <th class=\"right\" style=\"width:60px\">Qty</th>\r\n          <th class=\"right\" style=\"width:120px\">Harga</th>\r\n          <th class=\"right\" style=\"width:120px\">Jumlah</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        {% for item in page_items %}\r\n        <tr>\r\n          <td>{{ start_idx + loop.index }}</td>\r\n          <td>\r\n            {% set desc_lines = (item.description or item.item_name or \"\").split(\"\\n\") %}\r\n            <div class=\"item-main\">{{ desc_lines[0] if desc_lines | length > 0 else \"-\" }}</div>\r\n            {% if desc_lines | length > 1 %}\r\n              <div class=\"item-sub\">{{ desc_lines[1] }}</div>\r\n            {% endif %}\r\n          </td>\r\n          <td class=\"right\">{{ item.qty | int }} unit</td>\r\n          <td class=\"right\">Rp {{ \"{:,.0f}\".format(item.rate) }}</td>\r\n          <td class=\"right\">Rp {{ \"{:,.0f}\".format(item.amount) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n      </tbody>\r\n    </table>\r\n\r\n    <!-- PAGE SUBTOTAL -->\r\n    <table class=\"inv-totals-table\">\r\n      <tr class=\"subtotal-row\">\r\n        <td class=\"spacer\"></td>\r\n        <td>Subtotal Halaman {{ page_num }}</td>\r\n        <td class=\"value\">Rp {{ \"{:,.0f}\".format(page_subtotal) }}</td>\r\n      </tr>\r\n    </table>\r\n\r\n    <!-- GRAND TOTAL (only on last page) -->\r\n    {% if page_num == total_pages %}\r\n      <table class=\"inv-totals-table\">\r\n        {% for tax in doc.taxes %}\r\n        <tr class=\"tax-row\">\r\n          <td class=\"spacer\"></td>\r\n          <td>{{ tax.description }}</td>\r\n          <td class=\"value\">Rp {{ \"{:,.0f}\".format(tax.tax_amount) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n        <tr class=\"total-row\">\r\n          <td class=\"spacer\"></td>\r\n          <td>TOTAL</td>\r\n          <td class=\"value\">Rp {{ \"{:,.0f}\".format(doc.grand_total) }}</td>\r\n        </tr>\r\n      </table>\r\n\r\n      <!-- TERBILANG (only on last page) -->\r\n      {% if doc.in_words %}\r\n      <div class=\"inv-terbilang\">\r\n        <strong>Terbilang:</strong> {{ doc.in_words }}\r\n      </div>\r\n      {% endif %}\r\n\r\n      <!-- FOOTER (only on last page) -->\r\n      <div class=\"inv-footer\">\r\n        <div class=\"inv-payment-info\">\r\n          <div class=\"pay-label\">Catatan Pembayaran</div>\r\n          <div class=\"pay-detail\">\r\n            {% if company.default_bank_account %}Transfer ke {{ company.default_bank_account }} a/n {{ company.company_name }}.<br>{% endif %}\r\n            Cantumkan nomor invoice pada keterangan transfer.\r\n          </div>\r\n        </div>\r\n        <div class=\"inv-signature\">\r\n          <div style=\"height: 50px;\"></div>\r\n          <div class=\"sig-line\">Hormat Kami,</div>\r\n          <div class=\"sig-name\">{{ company.company_name }}</div>\r\n          <div style=\"font-size:9px;color:#94a3b8;margin-top:2px;\">Authorized Signature</div>\r\n        </div>\r\n      </div>\r\n    {% endif %}\r\n\r\n    <!-- BOTTOM BAR (on every page) -->\r\n    <div class=\"inv-bottom-bar\">\r\n      <span>{{ company.company_name }} — Dokumen dibuat secara otomatis oleh sistem.</span>\r\n      <span>Halaman {{ page_num }} / {{ total_pages }}</span>\r\n    </div>\r\n\r\n  </div>\r\n\r\n{% endfor %}",
