  "format_data": null,
  "html": "\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  body { font-family: Arial, sans-serif; font-size: 12px; color: #333; margin: 0; padding: 20px; }\n  .header { background: #1a2e4a; color: white; padding: 20px; display: flex; justify-content: space-between; align-items: flex-start; }\n  .header-left .company-name { font-size: 22px; font-weight: bold; }\n  .header-left .company-sub { color: #f0a500; font-size: 11px; }\n  .header-left .company-addr { font-size: 10px; margin-top: 4px; }\n  .header-right { text-align: right; }\n  .header-right .doc-title { font-size: 16px; font-weight: bold; }\n  .header-right .doc-sub { color: #f0a500; font-size: 11px; }\n  .header-right .doc-info { font-size: 10px; margin-top: 4px; }\n  .amount-box { background: #1a2e4a; color: white; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; margin-top: 0; }\n  .amount-box .label { font-size: 10px; color: #aaa; text-transform: uppercase; }\n  .amount-box .amount { font-size: 24px; font-weight: bold; }\n  .amount-box .method-label { font-size: 10px; color: #aaa; text-transform: uppercase; text-align: right; }\n  .amount-box .method-value { color: #f0a500; font-size: 14px; font-weight: bold; text-align: right; }\n  .amount-box .ref { font-size: 10px; text-align: right; }\n  .terbilang { background: #fff8e1; border-left: 3px solid #f0a500; padding: 10px 16px; font-style: italic; color: #555; margin: 0; }\n  .content { padding: 16px 0; }\n  .two-col { display: flex; gap: 16px; }\n  .box { flex: 1; background: #f0f4f8; padding: 14px; border-radius: 4px; }\n  .box-title { color: #1a2e4a; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }\n  .box-row { display: flex; justify-content: space-between; margin-bottom: 6px; }\n  .box-row .key { color: #666; }\n  .box-row .val { font-weight: bold; text-align: right; }\n  .section-title { color: #1a2e4a; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin: 16px 0 8px; }\n  .remarks-box { border: 1px solid #ddd; padding: 12px; border-radius: 4px; color: #444; line-height: 1.6; }\n  .disclaimer { border-left: 3px solid #90caf9; background: #e3f2fd; padding: 10px 16px; color: #1565c0; margin: 12px 0; font-size: 11px; line-height: 1.6; }\n  .sign-row { display: flex; gap: 16px; margin-top: 16px; }\n  .sign-box { flex: 1; border: 1px solid #ddd; padding: 16px; border-radius: 4px; text-align: center; }\n  .sign-box .sign-title { color: #1a2e4a; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }\n  .sign-box .sign-role { color: #666; font-size: 11px; margin-bottom: 50px; }\n  .sign-box .sign-line { border-top: 1px dashed #aaa; padding-top: 6px; }\n  .sign-box .sign-name { font-weight: bold; font-size: 12px; }\n  .sign-box .sign-sub { color: #666; font-size: 10px; }\n  .footer { background: #1a2e4a; color: #aaa; padding: 10px 20px; display: flex; justify-content: space-between; font-size: 10px; margin-top: 16px; }\n  .footer span { color: #f0a500; }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div class=\"header-left\">\n    <div class=\"company-name\">IMOGI</div>\n    <div class=\"company-sub\">{{ doc.company }}</div>\n    <div class=\"company-addr\">{{ doc.company_address if doc.company_address else '' }}</div>\n  </div>\n  <div class=\"header-right\">\n    <div class=\"doc-title\">Bukti Serah Terima Uang Jalan</div>\n    <div class=\"doc-sub\">Payment Entry — Uang Jalan Driver Towing</div>\n    <div class=\"doc-info\">{{ doc.name }} | {{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</div>\n  </div>\n</div>\n\n<div class=\"amount-box\">\n  <div>\n    <div class=\"label\">Total Dibayarkan</div>\n    <div class=\"amount\">Rp {{ '{:,.0f}'.format(doc.paid_amount).replace(',', '.') }}</div>\n  </div>\n  <div>\n    <div class=\"method-label\">Metode Pembayaran</div>\n    <div class=\"method-value\">{{ doc.mode_of_payment or 'Tunai' }}</div>\n    <div class=\"ref\">{% if doc.references %}Ref: {{ doc.references[0].reference_name }}{% endif %}</div>\n  </div>\n</div>\n\n<div class=\"terbilang\">\n  Terbilang: {{ terbilang_id(doc.paid_amount) }}\n</div>\n\n<div class=\"content\">\n  <div class=\"two-col\">\n    <div class=\"box\">\n      <div class=\"box-title\">Penerima (Driver)</div>\n      <div class=\"box-row\"><span class=\"key\">Nama</span><span class=\"val\">{{ doc.party }}</span></div>\n      <div class=\"box-row\"><span class=\"key\">Tipe</span><span class=\"val\">{{ doc.party_type }}</span></div>\n      <div class=\"box-row\"><span class=\"key\">No. HP</span><span class=\"val\">—</span></div>\n    </div>\n    <div class=\"box\">\n      <div class=\"box-title\">Detail Penugasan</div>\n      {% if doc.delivery_order_towing %}\n      {% set do = frappe.get_doc(\"Delivery Order Towing\", doc.delivery_order_towing) %}\n      <div class=\"box-row\"><span class=\"key\">Ref. DO Towing</span><span class=\"val\">{{ doc.delivery_order_towing }}</span></div>\n      <div class=\"box-row\"><span class=\"key\">Kendaraan</span><span class=\"val\">{{ do.kendaraan_towing or '—' }}</span></div>\n      <div class=\"box-row\"><span class=\"key\">Rute</span><span class=\"val\">{{ do.kota_pickup }} → {{ do.kota_tujuan }}</span></div>\n      <div class=\"box-row\"><span class=\"key\">Tanggal Tugas</span><span class=\"val\">{{ frappe.format(do.tanggal_do, {'fieldtype': 'Date'}) }}</span></div>\n      {% else %}\n      <div class=\"box-row\"><span class=\"key\">Ref. DO Towing</span><span class=\"val\">—</span></div>\n      <div class=\"box-row\"><span class=\"key\">Kendaraan</span><span class=\"val\">—</span></div>\n      <div class=\"box-row\"><span class=\"key\">Rute</span><span class=\"val\">—</span></div>\n      <div class=\"box-row\"><span class=\"key\">Tanggal Tugas</span><span class=\"val\">{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span></div>\n      {% endif %}\n    </div>\n  </div>\n\n  <div class=\"section-title\">Keterangan (Remarks)</div>\n  <div class=\"remarks-box\">{{ doc.remarks or '—' }}</div>\n\n  <div class=\"disclaimer\">\n    Dengan ditandatanganinya dokumen ini, penerima menyatakan telah menerima uang jalan sejumlah nominal di atas dalam keadaan baik dan benar, serta bersedia melaksanakan penugasan towing sesuai Delivery Order yang tercantum.\n  </div>\n\n  <div class=\"sign-row\">\n    <div class=\"sign-box\">\n      <div class=\"sign-title\">Diserahkan Oleh</div>\n      <div class=\"sign-role\">Koordinator / Kasir</div>\n      <div class=\"sign-line\">\n        <div class=\"sign-name\">{{ doc.company }}</div>\n        <div class=\"sign-sub\">Nama Jelas & Tanda Tangan</div>\n      </div>\n    </div>\n    <div class=\"sign-box\">\n      <div class=\"sign-title\">Diterima Oleh</div>\n      <div class=\"sign-role\">Driver</div>\n      <div class=\"sign-line\">\n        <div class=\"sign-name\">{{ doc.party }}</div>\n        <div class=\"sign-sub\">Nama Jelas & Tanda Tangan</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"footer\">\n  <span>IMOGI</span> Towing — Dicetak dari sistem. Berlaku sebagai bukti sah serah terima uang jalan.\n  <span>{{ doc.name }}</span>\n</div>\n\n</body>\n</html>\n",
