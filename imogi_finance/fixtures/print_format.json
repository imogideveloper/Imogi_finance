  "format_data": null,
  "html": "\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: Arial, sans-serif; font-size: 11px; color: #333; padding: 20px; }\n  .header { background: #1a2e4a; color: white; padding: 16px 20px; display: flex; justify-content: space-between; align-items: flex-start; }\n  .header-left .brand { font-size: 20px; font-weight: bold; }\n  .header-left .company { color: #f0a500; font-size: 11px; font-weight: bold; text-transform: uppercase; }\n  .header-left .address { font-size: 10px; margin-top: 4px; color: #ccc; }\n  .header-right { text-align: right; }\n  .header-right .title { font-size: 18px; font-weight: bold; }\n  .header-right .subtitle { color: #f0a500; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }\n  .header-right .docinfo { font-size: 10px; margin-top: 4px; }\n  .status-badge { background: #f0a500; color: #1a2e4a; padding: 2px 10px; border-radius: 3px; font-size: 10px; font-weight: bold; margin-top: 6px; display: inline-block; }\n  .mandate-box { background: #eef2f7; border-left: 4px solid #1a2e4a; padding: 12px 16px; margin: 12px 0; font-size: 11px; line-height: 1.6; }\n  .mandate-box a { color: #f0a500; font-weight: bold; text-decoration: none; }\n  .two-col { display: flex; gap: 12px; margin: 12px 0; }\n  .info-box { flex: 1; background: #f7f9fc; border: 1px solid #e0e6ef; border-radius: 4px; padding: 12px; }\n  .info-box .box-title { color: #1a2e4a; font-size: 9px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }\n  .info-row { display: flex; justify-content: space-between; margin-bottom: 5px; }\n  .info-row .key { color: #666; }\n  .info-row .val { font-weight: bold; text-align: right; }\n  .section-title { color: #1a2e4a; font-size: 9px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin: 14px 0 8px; border-bottom: 1px solid #e0e6ef; padding-bottom: 4px; }\n  .vehicle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 20px; background: #f7f9fc; border: 1px solid #e0e6ef; border-radius: 4px; padding: 12px; }\n  .vehicle-row { display: flex; justify-content: space-between; }\n  .vehicle-row .key { color: #666; }\n  .vehicle-row .val { font-weight: bold; }\n  .doc-badge { display: inline-block; border: 1px solid #1a2e4a; padding: 2px 8px; border-radius: 3px; font-size: 10px; margin-right: 4px; }\n  .doc-badge.active { background: #1a2e4a; color: white; }\n  .route-box { background: #1a2e4a; color: white; padding: 14px 20px; border-radius: 4px; display: flex; justify-content: space-between; align-items: center; margin: 8px 0; }\n  .route-box .loc { text-align: center; }\n  .route-box .loc-label { font-size: 9px; color: #aaa; text-transform: uppercase; letter-spacing: 1px; }\n  .route-box .loc-name { font-size: 16px; font-weight: bold; }\n  .route-box .arrow { text-align: center; color: #f0a500; font-size: 18px; }\n  .route-box .distance { font-size: 9px; color: #aaa; }\n  .instruksi { background: #f7f9fc; border: 1px solid #e0e6ef; border-radius: 4px; padding: 12px; }\n  .instruksi ol { padding-left: 16px; }\n  .instruksi li { margin-bottom: 6px; line-height: 1.5; }\n  .catatan-box { border: 1px solid #e0e6ef; border-radius: 4px; padding: 12px; min-height: 50px; color: #999; font-style: italic; }\n  .sign-row { display: flex; gap: 12px; margin-top: 14px; }\n  .sign-box { flex: 1; border: 1px solid #e0e6ef; border-radius: 4px; padding: 12px; text-align: center; }\n  .sign-box .sign-title { color: #1a2e4a; font-size: 9px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }\n  .sign-box .sign-role { color: #666; font-size: 10px; margin-bottom: 40px; }\n  .sign-box .sign-line { border-top: 1px dashed #aaa; padding-top: 6px; }\n  .sign-box .sign-name { font-weight: bold; font-size: 11px; }\n  .sign-box .sign-sub { color: #666; font-size: 10px; }\n  .footer { background: #1a2e4a; color: #aaa; padding: 8px 20px; display: flex; justify-content: space-between; font-size: 10px; margin-top: 14px; }\n  .footer span { color: #f0a500; }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div class=\"header-left\">\n    <div class=\"brand\">IMOGI</div>\n    <div class=\"company\">{% set company = doc.company or frappe.db.get_single_value('Global Defaults', 'default_company') %}{{ company }}</div>\n    <div class=\"address\">{% set comp = frappe.get_doc('Company', company) %}{% if comp.phone_no %}{{ comp.phone_no }}{% endif %}</div>\n  </div>\n  <div class=\"header-right\">\n    <div class=\"title\">Surat Perintah Kerja</div>\n    <div class=\"subtitle\">Towing — Delivery Order Towing</div>\n    <div class=\"docinfo\">SPK / {{ doc.name }} | {{ frappe.format(doc.tanggal_do, {'fieldtype': 'Date'}) }}</div>\n    <div class=\"status-badge\">{{ doc.status.upper() }}</div>\n  </div>\n</div>\n\n<div class=\"mandate-box\">\n  Dengan dokumen ini, <a>{% set company = doc.company or frappe.db.get_single_value('Global Defaults', 'default_company') %}{{ company }}</a> menugaskan driver <a>{{ doc.driver_nama or '_______________' }}</a> menggunakan unit towing — untuk melaksanakan pengambilan dan pengiriman kendaraan milik customer <a>{{ doc.customer_name }}</a> sesuai detail di bawah.\n</div>\n\n<div class=\"two-col\">\n  <div class=\"info-box\">\n    <div class=\"box-title\">Customer</div>\n    <div class=\"info-row\"><span class=\"key\">Nama</span><span class=\"val\">{{ doc.customer_name }}</span></div>\n    <div class=\"info-row\"><span class=\"key\">Tanggal DO</span><span class=\"val\">{{ frappe.format(doc.tanggal_do, {'fieldtype': 'Date'}) }}</span></div>\n    <div class=\"info-row\"><span class=\"key\">Ref. SO</span><span class=\"val\">{{ doc.sales_order or '_______________' }}</span></div>\n  </div>\n  <div class=\"info-box\">\n    <div class=\"box-title\">Penugasan</div>\n    <div class=\"info-row\"><span class=\"key\">Driver</span><span class=\"val\">{{ doc.driver_nama or '_______________' }}</span></div>\n    <div class=\"info-row\"><span class=\"key\">Unit Towing</span><span class=\"val\">{{ doc.kendaraan_towing or '_______________' }}</span></div>\n    <div class=\"info-row\"><span class=\"key\">Koordinator</span><span class=\"val\">{{ doc.koordinator or '_______________' }}</span></div>\n    <div class=\"info-row\"><span class=\"key\">Rencana Pick Up</span><span class=\"val\">{{ frappe.format(doc.tanggal_pickup_rencana, {'fieldtype': 'Datetime'}) if doc.tanggal_pickup_rencana else '_______________' }}</span></div>\n  </div>\n</div>\n\n<div class=\"section-title\">Data Kendaraan yang Diangkut</div>\n<div class=\"vehicle-grid\">\n  <div class=\"vehicle-row\"><span class=\"key\">Nomor Polisi</span><span class=\"val\">{{ doc.nomor_polisi or '_______________' }}</span></div>\n  <div class=\"vehicle-row\"><span class=\"key\">Tahun</span><span class=\"val\">{{ doc.tahun_kendaraan or '_______________' }}</span></div>\n  <div class=\"vehicle-row\"><span class=\"key\">Merk</span><span class=\"val\">{{ doc.merk_kendaraan or '_______________' }}</span></div>\n  <div class=\"vehicle-row\"><span class=\"key\">No. Rangka (VIN)</span><span class=\"val\">{{ doc.nomor_rangka or '_______________' }}</span></div>\n  <div class=\"vehicle-row\"><span class=\"key\">Tipe / Model</span><span class=\"val\">{{ doc.tipe_kendaraan or '_______________' }}</span></div>\n  <div class=\"vehicle-row\"><span class=\"key\">No. Mesin</span><span class=\"val\">{{ doc.nomor_mesin or '_______________' }}</span></div>\n  <div class=\"vehicle-row\"><span class=\"key\">Warna</span><span class=\"val\">{{ doc.warna_kendaraan or '_______________' }}</span></div>\n  {% if doc.dokumen_stnk or doc.dokumen_bpkb %}\n  <div class=\"vehicle-row\">\n    <span class=\"key\">Dokumen diterima</span>\n    <span class=\"val\">\n      {% if doc.dokumen_stnk %}<span class=\"doc-badge active\">STNK</span>{% endif %}\n      {% if doc.dokumen_bpkb %}<span class=\"doc-badge active\">BPKB</span>{% endif %}\n    </span>\n  </div>\n  {% endif %}\n</div>\n\n<div class=\"section-title\">Rute Penugasan</div>\n<div class=\"route-box\">\n  <div class=\"loc\">\n    <div class=\"loc-label\">Lokasi Pick Up</div>\n    <div class=\"loc-name\">{{ doc.kota_pickup or '_______________' }}</div>\n  </div>\n  <div class=\"arrow\">\n    →<br>\n    <div class=\"distance\">Estimasi Jarak<br>{{ doc.estimasi_jarak_km or '_______________' }} km</div>\n  </div>\n  <div class=\"loc\">\n    <div class=\"loc-label\">Lokasi Tujuan</div>\n    <div class=\"loc-name\">{{ doc.kota_tujuan or '_______________' }}</div>\n  </div>\n</div>\n\n<div class=\"section-title\">Instruksi Pelaksanaan</div>\n<div class=\"instruksi\">\n  <ol>\n    <li>Datang ke lokasi pick up sesuai jadwal yang ditentukan koordinator.</li>\n    <li>Periksa kondisi kendaraan bersama pengirim sebelum memuat ke unit towing.</li>\n    <li>Terima dan simpan dokumen kendaraan (STNK/BPKB) yang diserahkan oleh customer.</li>\n    <li>Pastikan kendaraan terpasang aman sebelum berangkat.</li>\n    <li>Antar kendaraan ke lokasi tujuan dan serahkan kepada penerima yang berwenang.</li>\n    <li>Laporkan ke koordinator segera setelah kendaraan berhasil diserahkan.</li>\n  </ol>\n</div>\n\n<div class=\"section-title\">Catatan Khusus</div>\n<div class=\"catatan-box\">{{ doc.catatan_khusus or 'Diisi koordinator sebelum SPK dicetak...' }}</div>\n\n<div class=\"sign-row\">\n  <div class=\"sign-box\">\n    <div class=\"sign-title\">Diterbitkan Oleh</div>\n    <div class=\"sign-role\">Koordinator / Penanggung Jawab</div>\n    <div class=\"sign-line\">\n      <div class=\"sign-name\">{% set company = doc.company or frappe.db.get_single_value('Global Defaults', 'default_company') %}{{ company }}</div>\n      <div class=\"sign-sub\">Nama jelas & TTD</div>\n    </div>\n  </div>\n  <div class=\"sign-box\">\n    <div class=\"sign-title\">Diterima & Dilaksanakan Oleh</div>\n    <div class=\"sign-role\">Driver</div>\n    <div class=\"sign-line\">\n      <div class=\"sign-name\">{{ doc.driver_nama or '_______________' }}</div>\n      <div class=\"sign-sub\">Nama jelas & TTD</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"footer\">\n  <span>IMOGI</span> Towing — Dicetak saat status Assigned. Dokumen internal perintah kerja driver.\n  <span>{{ doc.name }}</span>\n</div>\n\n</body>\n</html>\n",
