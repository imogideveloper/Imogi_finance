    "query": "SELECT\n  am.name AS \"Movement ID\",\n  am.purpose AS \"Purpose\",\n  am.transaction_date AS \"Transaction Date\",\n  ami.asset AS \"Asset ID\",\n  ami.asset_name AS \"Asset Name\",\n  ami.source_location AS \"From Location\",\n  ami.target_location AS \"To Location\",\n  emp_from.employee_name AS \"From Employee\",\n  emp_to.employee_name AS \"To Employee\",\n  am.company AS \"Company\"\nFROM\n  `tabAsset Movement` am\n  LEFT JOIN `tabAsset Movement Item` ami ON ami.parent = am.name\n  LEFT JOIN `tabEmployee` emp_from ON emp_from.name = ami.from_employee\n  LEFT JOIN `tabEmployee` emp_to ON emp_to.name = ami.to_employee\nWHERE\n  am.docstatus = 1\nORDER BY\n  am.transaction_date DESC",
